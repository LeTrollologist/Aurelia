# Build output. Per-crate `target/` trees are created by tests that keep their fixtures inside
# the build tree, so this must match at any depth, not just the repository root.
target/
dist/
**/*.rs.bk
*.pdb
*.exe
Cargo.lock.bk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.priv
keys/*.priv
scratch/
exports/
*.mp4
.env
__pycache__/
*.pyc

# Local build/UI-review artifacts
check.log
build.log
build.out
test.log
test.err
ui-*.png

# benchmark / build logs
*.log

# Release orchestrator state
.release/
tools/release/tests/_work/
